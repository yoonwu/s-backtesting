//@version=6
// 볼스위칭 신호 인디케이터 — s-backtesting/volswitch 전략의 트레이딩뷰 시각화
//
// 운영 스펙 (2026-07 히스테리시스 채택, results.md 검증):
//   진입: QQQ 종가 > MA150×1.005  AND  20일 실현변동성 < 32%
//   청산: QQQ 종가 < MA150×0.995  OR   20일 실현변동성 > 36%
//   예외매수: (QQQ < MA400 AND RSI14 < 30) OR 고점대비 -40%
// 어떤 차트에 올려도 신호는 QQQ 일봉 기준. MA 라인은 QQQ 차트에서만 의미 있음.
indicator("볼스위칭 신호 (QQQ 히스테리시스)", overlay = true)

maLen   = input.int(150,    "추세 MA 기간")
volWin  = input.int(20,     "변동성 윈도우 (일)")
volIn   = input.float(32.0, "진입: 변동성 임계 % (미만)")
volOut  = input.float(36.0, "청산: 변동성 임계 % (초과)")
maBufP  = input.float(0.5,  "MA 버퍼 % (진입 +/청산 -)", step = 0.1)
ma2Len  = input.int(200,    "비교 MA #2 (0=끔)")
ma3Len  = input.int(0,      "비교 MA #3 (0=끔)")
exMaLen = input.int(400,    "예외매수: MA 기간")
exRsiTh = input.float(30.0, "예외매수: RSI14 기준")
exDdTh  = input.float(40.0, "예외매수: 고점대비 낙폭 %")
showMa  = input.bool(true,  "MA 라인 표시 (QQQ 차트 권장)")

maBuf = maBufP / 100

// ---- QQQ 일봉 계산 (pandas 일치: 표본표준편차 보정) + 히스테리시스 상태기계 ----
calc() =>
    ret  = close / close[1] - 1
    vol  = ta.stdev(ret, volWin) * math.sqrt(volWin / (volWin - 1.0)) * math.sqrt(252) * 100
    ma   = ta.sma(close, maLen)
    ma2  = ma2Len > 0 ? ta.sma(close, ma2Len) : na
    ma3  = ma3Len > 0 ? ta.sma(close, ma3Len) : na
    exMa = ta.sma(close, exMaLen)
    rsi  = ta.rsi(close, 14)
    var float ath = na
    ath := na(ath) ? close : math.max(ath, close)
    dd = (close / ath - 1) * 100
    var bool on = false
    if not on and close > ma * (1 + maBuf) and vol < volIn
        on := true
    else if on and (close < ma * (1 - maBuf) or vol > volOut)
        on := false
    [close, ma, ma2, ma3, vol, exMa, rsi, dd, on]

[qC, qMa, qMa2, qMa3, qVol, qExMa, qRsi, qDd, hold] =
     request.security("NASDAQ:QQQ", "D", calc())

exception = (qC < qExMa and qRsi < exRsiTh) or (qDd <= -exDdTh)

// ---- 시각화 ----
// MA를 차트 심볼 단위로 환산해서 그림: 라인 = 차트가격 × (QQQ_MA / QQQ가격).
// QQQ 차트에서는 원값 그대로이고, TQQQ/NDX 등 다른 차트에서는 "QQQ가 MA에
// 닿는 순간 라인이 차트 가격에 닿는" 비율 보존 형태로 표시된다.
ratio = close / qC
bgcolor(hold ? color.new(color.green, 88) : color.new(color.red, 93))
plot(showMa ? qMa * ratio : na,   "MA(추세, 차트단위 환산)", color = color.orange, linewidth = 2)
plot(showMa ? qMa2 * ratio : na,  "비교 MA#2",             color = color.blue)
plot(showMa ? qMa3 * ratio : na,  "비교 MA#3",             color = color.purple)
plot(showMa ? qExMa * ratio : na, "MA(예외매수)",           color = color.gray)

entry  = hold and not hold[1]
exit_  = not hold and hold[1]
exBuy  = exception and not exception[1] and not hold
plotshape(entry, "진입(MOC 매수)",  shape.triangleup,   location.belowbar, color.green,  size = size.small)
plotshape(exit_, "청산(MOC 매도)",  shape.triangledown, location.abovebar, color.red,    size = size.small)
plotshape(exBuy, "예외매수 트리거", shape.diamond,      location.belowbar, color.orange, size = size.small)

// 올해 신호 전환 횟수
var int yCnt = 0
if year(time) != year(time[1])
    yCnt := 0
if hold != hold[1]
    yCnt += 1

// ---- 상태 테이블 ----
var table t = table.new(position.top_right, 2, 8, border_width = 1)
if barstate.islast
    stateCol = hold ? color.new(color.green, 60) : color.new(color.red, 60)
    table.cell(t, 0, 0, "신호", bgcolor = stateCol, text_color = color.white)
    table.cell(t, 1, 0, hold ? "HOLD" : "CASH", bgcolor = stateCol, text_color = color.white, text_size = size.large)
    table.cell(t, 0, 1, "QQQ", text_color = color.white)
    table.cell(t, 1, 1, str.tostring(qC, "#.##"), text_color = color.white)
    upper = qMa * (1 + maBuf)
    lower = qMa * (1 - maBuf)
    table.cell(t, 0, 2, "MA" + str.tostring(maLen) + " ±" + str.tostring(maBufP, "#.#") + "%", text_color = color.white)
    table.cell(t, 1, 2, str.tostring(lower, "#.#") + " ~ " + str.tostring(upper, "#.#", text_color = color.white)
         + (qC > upper ? " 위✓" : qC < lower ? " 아래✗" : " 버퍼중"))
    table.cell(t, 0, 3, str.tostring(volWin) + "일 변동성", text_color = color.white)
    table.cell(t, 1, 3, str.tostring(qVol, "#.#") + "% (진입<" + str.tostring(volIn, "#") + " 청산>" + str.tostring(volOut, "#") + ")", text_color = color.white)
    table.cell(t, 0, 4, "RSI14", text_color = color.white)
    table.cell(t, 1, 4, str.tostring(qRsi, "#.#"), text_color = color.white)
    table.cell(t, 0, 5, "고점대비", text_color = color.white)
    table.cell(t, 1, 5, str.tostring(qDd, "#.#") + "%", text_color = color.white)
    table.cell(t, 0, 6, "예외매수", bgcolor = exception ? color.new(color.orange, 40) : na, text_color = color.white)
    table.cell(t, 1, 6, exception ? "⚠ 발동" : "미발동", bgcolor = exception ? color.new(color.orange, 40) : na, text_color = color.white)
    table.cell(t, 0, 7, "올해 전환", text_color = color.white)
    table.cell(t, 1, 7, str.tostring(yCnt) + "회", text_color = color.white)

// ---- 알림 (생성 시 "봉 마감 시 1회 Once per bar close"로 설정) ----
alertcondition(entry, "볼스위칭 진입",     "볼스위칭: CASH→HOLD — 오늘 장마감 MOC 전량 매수")
alertcondition(exit_, "볼스위칭 청산",     "볼스위칭: HOLD→CASH — 오늘 장마감 MOC 전량 매도")
alertcondition(exBuy, "볼스위칭 예외매수", "볼스위칭: 예외매수 트리거 발동 — 사전 결정 비중만 매수")
